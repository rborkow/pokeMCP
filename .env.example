# PokéMCP Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Cloudflare Workers (MCP Server)
# ============================================
# Bindings are set in wrangler.jsonc and secrets in the Cloudflare dashboard, not in .env.
# The worker calls no AI model and needs no API keys to run locally (`bun run dev`).

# Only for `bun run generate-reports`, to write the narrative sections of the meta reports
# (set NARRATIVE=0 to skip them):
# ANTHROPIC_API_KEY=sk-ant-...
