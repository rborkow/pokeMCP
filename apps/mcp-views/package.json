{
    "name": "pokemcp-mcp-views",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.11",
    "description": "MCP Apps views for the VGC Teambuilder connector, built into single HTML files the Worker serves",
    "scripts": {
        "build": "bun run type-check && bun run build.ts",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "preview": "vite --config vite.preview.config.ts"
    },
    "dependencies": {
        "@modelcontextprotocol/client": "^2.4.0",
        "@modelcontextprotocol/core": "^2.4.0",
        "@modelcontextprotocol/ext-apps": "2.0.4",
        "preact": "10",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.6",
        "@types/node": "^24",
        "preact-render-to-string": "^6.8.3",
        "typescript": "5.9.3",
        "vite": "6",
        "vite-plugin-singlefile": "^2.3.4",
        "vitest": "^5.1.1"
    }
}
