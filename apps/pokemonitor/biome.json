{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "files": {
        "includes": ["src/**/*"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off",
                "useNodejsImportProtocol": "off"
            },
            "suspicious": {
                "noExplicitAny": "off"
            }
        }
    },
    "root": true,
    "vcs": {
        "clientKind": "git",
        "enabled": true,
        "useIgnoreFile": false
    }
}
