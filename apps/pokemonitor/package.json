  "description": "Automated daily reporting for the pokeMCP app — compute/storage, visitors, Claude API analytics, and query-type insights",
  "private": true,
  "author": "Robert Borkowski",
  "license": "AGPL-3.0",
  "packageManager": "bun@1.3.11",
  "scripts": {
