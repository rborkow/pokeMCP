{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "es2022",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "noEmit": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["@cloudflare/workers-types", "node"]
    },
    "include": ["src/**/*.ts"]
}
