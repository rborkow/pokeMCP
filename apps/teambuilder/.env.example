# www.pokemcp.com environment variables
# Copy this file to .env.local for a local deploy. The site needs no secrets.

# Cloudflare Web Analytics beacon token. NEXT_PUBLIC_* vars are inlined by Next
# at BUILD time, so this must be set when building, not as a Worker variable.
# Public by design (it ships in the page HTML); layout.tsx has a fallback.
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your-web-analytics-token

# MCP worker URL used by the admin dashboard's API proxy (defaults to production).
# NEXT_PUBLIC_MCP_URL=https://api.pokemcp.com
