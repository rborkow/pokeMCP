# PokéMCP Team Builder Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# Required for AI Chat Feature
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ============================================
# Optional Configuration
# ============================================
# MCP API URL (defaults to production API)
# Change this only for local development with a local MCP server
# NEXT_PUBLIC_MCP_URL=https://api.pokemcp.com

# AI Gateway — routes Claude API calls through Cloudflare AI Gateway
# for automatic token/cost tracking, request logging, and caching.
# Format: https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/anthropic
# CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/pokemcp/anthropic
# CF_AIG_TOKEN=your-ai-gateway-token

# Cloudflare Web Analytics beacon token (public — it ships in the page HTML).
# NEXT_PUBLIC_* vars are inlined by Next at BUILD time, so this must be set when
# `next build` runs — in .env.local for local `bun run deploy`, or as a Workers
# Builds environment variable for CI deploys. Setting it in wrangler.toml [vars]
# does NOT work (that's runtime-only, after the value is already inlined).
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your-web-analytics-token
