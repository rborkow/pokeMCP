{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "pokemon-mcp-production",
    "main": "src/index.ts",
    "compatibility_date": "2025-03-10",
    "compatibility_flags": ["nodejs_compat"],
    "migrations": [
        {
            "new_sqlite_classes": ["PokemonMCP"],
            "tag": "v1"
        },
        {
            // Historical migration already applied in production. Keep the tag
            // so Wrangler does not replay v1 against existing Durable Objects.
            "new_sqlite_classes": ["IngestionCoordinator"],
            "tag": "v2"
        }
    ],
    /**
     * DEFAULT ENVIRONMENT (Local Development)
     *
     * When running `npm run dev`, wrangler uses local simulation for KV/DO.
     * No cloud resources are accessed. This is safe for contributors.
     *
     * For production deployment, use: npm run deploy:production
     */
    "durable_objects": {
        "bindings": [
            {
                "class_name": "PokemonMCP",
                "name": "MCP_OBJECT"
            },
            {
                "class_name": "IngestionCoordinator",
                "name": "INGESTION_COORDINATOR"
            }
        ]
    },
    "kv_namespaces": [
        {
            "binding": "POKEMON_STATS",
            // Production KV - only accessed when deploying (not during local dev)
            "id": "58525ad4ec5c454eb3e1ae7586414483"
        },
        {
            "binding": "STRATEGY_DOCS",
            "id": "3be55e1e98144776a62ee00f5bced815"
        },
        {
            "binding": "SHARED_TEAMS",
            "id": "8b077446275b42d699c4e4d33b3bb353"
        }
    ],
    // Metagame evolution time-series store (history; KV stays the "latest" source of truth).
    "d1_databases": [
        {
            "binding": "META_DB",
            "database_name": "pokemcp-meta-history",
            // D1 id (not secret — like the KV ids above). Created via the Cloudflare API.
            // Apply schema with: wrangler d1 migrations apply META_DB --remote
            "database_id": "64752654-621e-4f0d-be90-3e200e73097c",
            "migrations_dir": "migrations/d1"
        }
    ],
    "vectorize": [
        {
            "binding": "VECTOR_INDEX",
            "index_name": "pokemon-strategy-index"
        }
    ],
    "ai": {
        "binding": "AI"
    },
    // Legacy R2 binding retained only for explicit content-sharing opt-ins.
    // Content logging is disabled by default in src/logging.ts.
    "r2_buckets": [
        {
            "binding": "INTERACTION_LOGS",
            "bucket_name": "pokemcp-interaction-logs"
        }
    ],
    // Email Workers binding for feedback notifications
    // Requires Email Routing enabled on pokemcp.com with feedback@ routed to a destination
    "send_email": [
        {
            "name": "SEND_EMAIL",
            "destination_address": "feedback@pokemcp.com"
        }
    ],
    // Analytics Engine for usage monitoring (admin dashboard)
    "analytics_engine_datasets": [
        {
            "binding": "ANALYTICS",
            "dataset": "pokemcp-analytics"
        }
    ],
    // No cron triggers in default environment (only production)
    "limits": {
        "cpu_ms": 5000
    },
    "observability": {
        "enabled": true
    },
    "vars": {
        "ENVIRONMENT": "development",
        "AI_GATEWAY_ID": "pokemcp"
    },
    /**
     * ENVIRONMENT-SPECIFIC CONFIGURATIONS
     *
     * Production: Deployed via CI/CD on merge to main
     * Staging: Optional preview environment for testing
     */
    "env": {
        "staging": {
            "name": "pokemon-mcp-staging",
            "vars": {
                "ENVIRONMENT": "staging",
                "AI_GATEWAY_ID": "pokemcp"
            },
            // Staging uses the same KV as production (read-only access is fine)
            // To create separate staging KV, run:
            //   npx wrangler kv namespace create POKEMON_STATS_STAGING
            //   npx wrangler kv namespace create STRATEGY_DOCS_STAGING
            "kv_namespaces": [
                {
                    "binding": "POKEMON_STATS",
                    "id": "58525ad4ec5c454eb3e1ae7586414483"
                },
                {
                    "binding": "STRATEGY_DOCS",
                    "id": "3be55e1e98144776a62ee00f5bced815"
                },
                {
                    "binding": "SHARED_TEAMS",
                    "id": "8b077446275b42d699c4e4d33b3bb353"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "INTERACTION_LOGS",
                    "bucket_name": "pokemcp-interaction-logs"
                }
            ],
            "vectorize": [
                {
                    "binding": "VECTOR_INDEX",
                    "index_name": "pokemon-strategy-index"
                }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "class_name": "PokemonMCP",
                        "name": "MCP_OBJECT"
                    },
                    {
                        "class_name": "IngestionCoordinator",
                        "name": "INGESTION_COORDINATOR"
                    }
                ]
            },
            "send_email": [
                {
                    "name": "SEND_EMAIL",
                    "destination_address": "feedback@pokemcp.com"
                }
            ],
            "ai": {
                "binding": "AI"
            },
            "analytics_engine_datasets": [
                {
                    "binding": "ANALYTICS",
                    "dataset": "pokemcp-analytics"
                }
            ],
            "d1_databases": [
                {
                    "binding": "META_DB",
                    "database_name": "pokemcp-meta-history",
                    // Staging may share the production DB id (as KV does), or use its own.
                    "database_id": "64752654-621e-4f0d-be90-3e200e73097c",
                    "migrations_dir": "migrations/d1"
                }
            ]
        },
        "production": {
            "name": "pokemon-mcp-production",
            "vars": {
                "ENVIRONMENT": "production",
                "AI_GATEWAY_ID": "pokemcp"
            },
            "kv_namespaces": [
                {
                    "binding": "POKEMON_STATS",
                    "id": "58525ad4ec5c454eb3e1ae7586414483"
                },
                {
                    "binding": "STRATEGY_DOCS",
                    "id": "3be55e1e98144776a62ee00f5bced815"
                },
                {
                    "binding": "SHARED_TEAMS",
                    "id": "8b077446275b42d699c4e4d33b3bb353"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "INTERACTION_LOGS",
                    "bucket_name": "pokemcp-interaction-logs"
                }
            ],
            "vectorize": [
                {
                    "binding": "VECTOR_INDEX",
                    "index_name": "pokemon-strategy-index"
                }
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "class_name": "PokemonMCP",
                        "name": "MCP_OBJECT"
                    },
                    {
                        "class_name": "IngestionCoordinator",
                        "name": "INGESTION_COORDINATOR"
                    }
                ]
            },
            "send_email": [
                {
                    "name": "SEND_EMAIL",
                    "destination_address": "feedback@pokemcp.com"
                }
            ],
            "ai": {
                "binding": "AI"
            },
            "analytics_engine_datasets": [
                {
                    "binding": "ANALYTICS",
                    "dataset": "pokemcp-analytics"
                }
            ],
            "d1_databases": [
                {
                    "binding": "META_DB",
                    "database_name": "pokemcp-meta-history",
                    "database_id": "64752654-621e-4f0d-be90-3e200e73097c",
                    "migrations_dir": "migrations/d1"
                }
            ],
            // Daily tournament refresh plus weekly RAG content ingestion.
            "triggers": {
                "crons": ["0 6 * * *", "0 3 * * SUN"]
            }
        }
    }
}
